#!/bin/sh
#
# fwp — FreeBSD Web Panel startup script.
#
# PROVIDE: fwp
# REQUIRE: DAEMON
# KEYWORD: shutdown
#
# Add the following lines to /etc/rc.conf to enable fwp:
#
#   fwp_enable="YES"
#   fwp_config="/usr/local/etc/fwp.toml"   # optional, default shown
#   fwp_user="root"                         # optional, must be root
#
# See fwp.toml for runtime configuration.

. /etc/rc.subr

name=fwp
rcvar=fwp_enable

load_rc_config $name

: ${fwp_enable:=NO}
: ${fwp_config:=/usr/local/etc/fwp.toml}
: ${fwp_user:=root}

command=/usr/local/sbin/${name}
command_args="--config ${fwp_config}"
pidfile=/var/run/${name}.pid
# fwp runs in the foreground; daemon(8) detaches it and owns the pidfile.
# rc.subr's default start/stop/status resolve liveness via check_pidfile()
# on ${pidfile} and refuse a second start while the recorded pid is alive,
# so no custom start_cmd is needed.
fwp_prepend="/usr/sbin/daemon -t freebsd-web-panel -f -p ${pidfile} -u ${fwp_user}"

run_rc_command "$1"
